# ==============================================================================
# Terraform Ignore (.terraformignore)
# ==============================================================================

# Compiled and cache files
**/.terraform/*
.terraform/

# State files & backups
*.tfstate
*.tfstate.*
*.tfstate.backup

# Execution plan files
tfplan
*.tfplan
*.plan

# Crash log files
crash.log
crash.*.log

# Sensitive variable definition files
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Backend configuration files with generated credentials/account names
backend.hcl
*.hcl.backup

# CLI configuration files
.terraformrc
terraform.rc

# OS and Editor files
.DS_Store
Thumbs.db
*.swp
*.bak
*~
.idea/
.vscode/
